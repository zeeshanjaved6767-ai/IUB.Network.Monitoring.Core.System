# render.yaml - Complete configuration for IUB Network Monitoring Core System

services:
  # Main Web Service for Backend + Frontend
  - type: web
    name: iub-network-monitor
    runtime: node
    plan: free
    autoDeploy: true
    buildCommand: npm install && npm run build
    startCommand: npm start
    healthCheckPath: /api/health
    envVars:
      - key: NODE_ENV
        value: production
      
      # Gemini AI API Key (REQUIRED)
      - key: GEMINI_API_KEY
        sync: false  # You'll enter this manually in Render dashboard
      
      # App URL (Auto-set by Render)
      - key: APP_URL
        fromService:
          type: web
          name: iub-network-monitor
          property: url
      
      # Firebase Configuration
      - key: FIREBASE_PROJECT_ID
        value: "project-41c28270-5f5d-4334-901"
      
