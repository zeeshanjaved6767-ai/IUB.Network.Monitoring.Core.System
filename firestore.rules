rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /devices/{deviceId} {
      allow read: if true;
      allow write: if request.auth != null && isValidId(deviceId);

      match /history/{historyId} {
        allow read: if true;
        allow write: if request.auth != null && isValidId(historyId);
      }
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow write: if request.auth != null && isValidId(alertId);
    }

    match /collector_tokens/{tokenId} {
      allow read, write: if request.auth != null && isValidId(tokenId);
    }

    match /hardware_health_logs/{logId} {
      allow read: if true;
      allow write: if request.auth != null && isValidId(logId);
    }
  }
}
